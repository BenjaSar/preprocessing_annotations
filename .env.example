#!/bin/bash
# Preprocessing Pipeline Configuration
# This file is loaded by run.sh and main.py

# ======================
# REQUIRED: API KEY
# ======================
export ANTHROPIC_API_KEY=<your_api_key_here>

# ======================
# VLM MODEL SELECTION
# ======================
# Choose one model:
#   - claude-haiku-4-5-20251001 (default) - Fast & cheap, $5 for 2,844 images
#   - claude-sonnet-4-5-20250929 - Balanced, $14 for 2,844 images
#   - claude-opus-4-6 - Best quality, $24 for 2,844 images

export VLM_MODEL=claude-haiku-4-5-20251001

# ======================
# MODEL PARAMETERS (Optional)
# ======================
# Maximum tokens in response (default: 4096)
export VLM_MAX_TOKENS=4096

# Number of retries for API calls (default: 3)
export VLM_MAX_RETRIES=3

# Delay between retries in seconds (default: 1.0)
export VLM_RETRY_DELAY=1.0